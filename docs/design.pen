                  "content": "Positioning Statement",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Yq5nB",
                  "name": "pg4posText",
                  "fill": "$--ink-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "API Dashboard is the internal command center for Predivo's API infrastructure. Unlike generic key vaults or spreadsheets, it combines credential management, health monitoring, cost tracking, and audit logging in one developer-optimized interface.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "gy62W",
                  "name": "pg4diffLabel",
                  "fill": "$--foreground",
                  "content": "What Makes Us Different",
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "z5VGP",
                  "name": "pg4diffText",
                  "fill": "$--ink-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Built specifically for multi-project API management with AES-256-GCM encryption, real-time health checks, and complete audit trails. Every credential is encrypted at rest, every access is logged, and every cost is visible.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
