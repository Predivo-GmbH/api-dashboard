        "sidebar-hover": "#1E293B",
        "sidebar-active": "#1E293B",
        "overlay": "rgba(0, 0, 0, 0.6)"
      },
      "ink": {
        "default": "#0F172A",
        "secondary": "#475569",
        "tertiary": "#94A3B8",
        "placeholder": "#CBD5E1",
        "inverse": "#F8FAFC",
        "sidebar": "#CBD5E1",
        "sidebar-active": "#FFFFFF"
      },
      "edge": {
        "default": "#E2E8F0",
