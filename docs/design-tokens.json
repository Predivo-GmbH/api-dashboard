      },
      "chart": {
        "primary": "#2DD4BF",
        "secondary": "#64748B",
        "tertiary": "#475569",
        "series-1": "#2DD4BF",
        "series-2": "#3B82F6",
        "series-3": "#F59E0B",
        "series-4": "#8B5CF6",
