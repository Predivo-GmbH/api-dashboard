  },

  "typography": {
    "fontFamily": {
      "sans": "'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'Cascadia Code', 'Fira Code', monospace"
    },
    "fontSize": {
      "display": { "size": "30px", "lineHeight": "36px", "weight": 700, "letterSpacing": "-0.02em" },
      "h1": { "size": "24px", "lineHeight": "32px", "weight": 700, "letterSpacing": "-0.01em" },
      "h2": { "size": "20px", "lineHeight": "28px", "weight": 600, "letterSpacing": "-0.01em" },
      "h3": { "size": "16px", "lineHeight": "24px", "weight": 600, "letterSpacing": "0" },
      "h4": { "size": "14px", "lineHeight": "20px", "weight": 600, "letterSpacing": "0" },
      "body": { "size": "14px", "lineHeight": "20px", "weight": 400, "letterSpacing": "0" },
      "body-sm": { "size": "13px", "lineHeight": "18px", "weight": 400, "letterSpacing": "0" },
      "caption": { "size": "12px", "lineHeight": "16px", "weight": 500, "letterSpacing": "0.01em" },
      "overline": { "size": "11px", "lineHeight": "16px", "weight": 600, "letterSpacing": "0.06em", "textTransform": "uppercase" },
      "mono-body": { "size": "13px", "lineHeight": "20px", "weight": 400, "letterSpacing": "0", "fontFamily": "mono" },
      "mono-sm": { "size": "12px", "lineHeight": "16px", "weight": 400, "letterSpacing": "0", "fontFamily": "mono" }
    }
  },

  "spacing": {
    "unit": 4,
    "scale": {
      "0": "0px",
      "0.5": "2px",
      "1": "4px",
      "1.5": "6px",
      "2": "8px",
      "2.5": "10px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px"
    }
  },

  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "full": "9999px"
  },

  "shadow": {
    "note": "Border-first design — shadows reserved for overlays only",
    "none": "none",
    "sm": "0 1px 2px rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05)"
  },

  "animation": {
    "duration": {
      "instant": "0ms",
      "fast": "100ms",
      "normal": "200ms",
      "slow": "300ms",
      "slower": "500ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)",
      "in-out": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },

  "layout": {
    "sidebar": {
      "width": "240px",
      "collapsedWidth": "64px"
    },
    "content": {
      "maxWidth": "1280px",
      "padding": {
        "desktop": "32px",
        "tablet": "24px",
        "mobile": "16px"
      }
    },
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px"
    },
    "grid": {
      "columns": 12,
      "gutter": "24px"
    },
    "table": {
      "rowHeight": "40px",
      "headerHeight": "40px",
      "cellPaddingX": "16px",
      "cellPaddingY": "8px"
    }
  },

  "iconography": {
    "library": "Lucide React",
    "sizes": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "24px"
    },
    "strokeWidth": 1.75,
    "color": "inherit"
  }
}
