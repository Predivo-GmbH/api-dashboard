      "surface": {
        "page": "#0C0F14",
        "default": "#151921",
        "elevated": "#1C2130",
        "sunken": "#0A0D11",
        "sidebar": "#0A0D11",
        "sidebar-hover": "#151921",
        "sidebar-active": "#151921",
        "overlay": "rgba(0, 0, 0, 0.8)"
      },
      "ink": {
        "default": "#F1F5F9",
